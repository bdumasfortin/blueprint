{
  "name": "blueprint-local-review",
  "version": "0.2.2",
  "description": "A human-gated, local-first review loop for one person, one agent, and one HTML artifact.",
  "type": "module",
  "bin": {
    "blueprint": "bin/blueprint.js"
  },
  "files": [
    "bin",
    "src",
    "LICENSE",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "start": "node bin/blueprint.js server",
    "test": "node --test --test-reporter=spec \"test/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=65 --test-coverage-functions=90 --test-reporter=spec \"test/*.test.js\"",
    "check:package": "node scripts/check-package.js",
    "check": "node --check bin/blueprint.js && npm run test:coverage && npm run check:package"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "axi",
    "agent",
    "html",
    "review",
    "local-first"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bdumasfortin/blueprint.git"
  },
  "homepage": "https://github.com/bdumasfortin/blueprint#readme",
  "bugs": {
    "url": "https://github.com/bdumasfortin/blueprint/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
