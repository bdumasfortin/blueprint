{
  "name": "blueprint-local-review",
  "version": "0.0.1",
  "private": true,
  "description": "A human-gated, local-first review loop for one person, one agent, and one HTML artifact.",
  "type": "module",
  "bin": {
    "blueprint": "bin/blueprint.js"
  },
  "scripts": {
    "start": "node bin/blueprint.js server",
    "test": "node --test --test-reporter=spec \"test/*.test.js\"",
    "check": "node --check bin/blueprint.js && node --test --test-reporter=spec \"test/*.test.js\""
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED"
}
